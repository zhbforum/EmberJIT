fn absolute(value: f64) -> f64 {
    if value < 0.0 {
        return -value;
    }
    return value;
}

fn bool_code(value: bool) -> i64 {
    if value {
        return 1;
    }
    return 0;
}

fn main() -> void {
    let number: f64 = absolute(-2.5);
    let equal: bool = number == 2.5;
    print_f64(number);
    print_i64(bool_code(equal));
}
